# ---- Required ----
# Random long string used to sign login sessions (e.g. `openssl rand -base64 32`)
AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the site (used in emails and Stripe redirects)
SITE_URL=http://localhost:3000

# First admin account (created/updated by `npm run db:seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ---- Database ----
# Local file (default) or Turso/libSQL in production: libsql://your-db.turso.io
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# ---- Media storage ----
# Folder for uploaded photos and videos (keep it outside /public; videos are streamed with access checks)
STORAGE_DIR=./storage

# ---- Stripe (card, Apple Pay, Google Pay) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Allow a simulated "test payment" button when Stripe keys are missing (never enable in production)
ALLOW_DEV_CHECKOUT=true

# ---- Email (optional). Without it, emails are saved to Admin → Emails instead of being sent ----
SMTP_URL=
EMAIL_FROM="Maryna Moroz Fitness <no-reply@example.com>"
